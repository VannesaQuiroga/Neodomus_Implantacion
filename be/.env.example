# Plantilla de variables de entorno del BACKEND (be/).
# Copia como be/.env y completa los valores reales. NUNCA versiones el .env real.

# === Base de datos ===
# Docker (el contenedor api usa el host 'db'): mysql+pymysql://neodomus:CAMBIAR@db:3306/neodomus
# Desarrollo local (MySQL expuesto en 3307):   mysql+pymysql://neodomus:CAMBIAR@localhost:3307/neodomus
DATABASE_URL=mysql+pymysql://neodomus:CAMBIAR@db:3306/neodomus?charset=utf8mb4

# === Seguridad / JWT ===
SECRET_KEY=genera_una_clave_larga_aleatoria_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development

# === Verificación de correo / recuperación ===
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

# === SMTP (opcional; en desarrollo se usa un transporte simulado en pruebas) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_PROVIDER=smtp

# === Google OAuth (opcional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SIGNIN_CLIENT_ID=

# === Pagos (simulador académico; no requiere credenciales) ===
PAYMENT_PROVIDER=simulator

# === MinIO (almacenamiento de objetos) ===
# Docker: endpoint minio:9000. Local: 127.0.0.1:9000.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=neodomus
MINIO_SECRET_KEY=CAMBIAR
MINIO_BUCKET=neodomus-media
MINIO_PRIVATE_BUCKET=neodomus-private
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_SECURE=false

# === Frontend ===
FRONTEND_URL=http://localhost:5173
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
FRONTEND_RESET_PASSWORD_PATH=/reset-password
