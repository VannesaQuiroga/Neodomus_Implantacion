# Plantilla de variables de entorno del FRONTEND WEB (fe/).
# Copia como fe/.env. NUNCA versiones el .env real.
# En desarrollo, Vite expone estas variables como import.meta.env.VITE_*.

# URL base de la API del backend.
VITE_API_URL=http://localhost:8000/api/v1

# Google Sign-In (opcional). Déjalo vacío si no usas Google OAuth.
VITE_GOOGLE_CLIENT_ID=
