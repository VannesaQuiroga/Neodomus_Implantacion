# ── Plantilla de variables de entorno ─────────────────────────
# Copia este archivo como ".env" y rellena los valores reales.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# === Base de datos ===
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=neodomus
MYSQL_USER=neodomus
MYSQL_PASSWORD=

# === Backend ===
DATABASE_URL=mysql+pymysql://neodomus:CAMBIAR@db:3306/neodomus?charset=utf8mb4
SECRET_KEY=genera_una_clave_larga_aleatoria_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
# Necesario para que Uvicorn detecte cambios de forma fiable en bind mounts Windows/WSL.
WATCHFILES_FORCE_POLLING=true
WATCHFILES_POLL_DELAY_MS=500
# Sembrar usuarios de prueba solo en desarrollo; usar false en staging/producción.
EJECUTAR_SEED_AL_ARRANCAR=true

# === SMTP (Gmail) — usa una contraseña de aplicación ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tucorreo@gmail.com
SMTP_PASSWORD=
EMAIL_PROVIDER=smtp

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SIGNIN_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# === Pagos (simulador académico) ===
PAYMENT_PROVIDER=simulator

# === Frontend ===
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# === MinIO ===
MINIO_ROOT_USER=neodomus
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=neodomus-media
